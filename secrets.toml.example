# 비밀값 템플릿 — 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 실제 키를 채운다.
# (.streamlit/secrets.toml 은 커밋되지 않는다. Streamlit Cloud 에서는
#  Settings > Secrets 칸에 동일한 toml 내용을 붙여넣는다.)

CLOVA_SECRET_KEY = "여기에-CLOVA-Secret-Key"
CLOVA_API_URL = "여기에-CLOVA-API-URL"
DEEPL_API_KEY = "여기에-DeepL-Auth-Key"

# ── Google 로그인(@boosters.kr 도메인 제한) ──────────────────
# 아래 [auth] 블록을 추가하면 회사 구글 계정 로그인이 활성화된다.
# (없으면 앱은 로그인 없이 동작 — 경고 배너 표시)
# 준비물: Google Cloud Console > OAuth 2.0 클라이언트 ID
#   - 승인된 리디렉션 URI = https://<배포된-앱-주소>.streamlit.app/oauth2callback
# [auth]
# redirect_uri = "https://<배포된-앱-주소>.streamlit.app/oauth2callback"
# cookie_secret = "아무거나-긴-랜덤-문자열-32자이상"
# client_id = "구글-OAuth-클라이언트-ID"
# client_secret = "구글-OAuth-클라이언트-시크릿"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
